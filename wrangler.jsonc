{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sudoku-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUDOKU_GAME",
        "class_name": "SudokuGame"
      }
    ]
  },
  "exports": {
    "SudokuGame": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
